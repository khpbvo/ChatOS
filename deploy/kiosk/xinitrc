#!/bin/sh
# xinitrc — X session script for the ChatOS kiosk.
# Run by xinit as root. Chromium is dropped to _chatos_ui via sudo.
#
# Flow:
#   1. Load config from kiosk.conf via Python exporter
#   2. Redirect output to kiosk log
#   3. Disable screensaver and power management
#   4. Set a clean black background
#   5. Hide cursor (if unclutter is installed)
#   6. Wait for the ChatOS server to be ready
#   7. Clean stale Chromium lock files
#   8. exec Chromium (replaces this shell — exit = X exit)

set -eu

CHATOS_DIR="/usr/local/share/chatos"
PYTHON="${CHATOS_DIR}/venv/bin/python"
KIOSK_CONF="/etc/chatos/kiosk.conf"

# Must be in app dir for `python -m src.*` to find the package
cd "${CHATOS_DIR}"

# Load kiosk config
eval "$("${PYTHON}" -m src.kiosk_config "${KIOSK_CONF}")"

# Redirect stdout/stderr to log file
exec >>"${KIOSK_LOG_FILE}" 2>&1
echo "--- kiosk session start: $(date) ---"

# Disable screensaver and DPMS power management
xset s off
xset -dpms

# Clean black background while Chromium loads
xsetroot -solid black

# Hide cursor after 3 seconds of inactivity (if unclutter is installed)
if command -v unclutter >/dev/null 2>&1; then
    sudo -u _chatos_ui unclutter -idle 3 -root &
fi

# Wait for ChatOS server to be ready
elapsed=0
while ! nc -z 127.0.0.1 "${KIOSK_PORT}" 2>/dev/null; do
    elapsed=$((elapsed + KIOSK_POLL_INTERVAL))
    if [ "${elapsed}" -ge "${KIOSK_SERVER_TIMEOUT}" ]; then
        echo "ERROR: server not ready after ${KIOSK_SERVER_TIMEOUT}s on port ${KIOSK_PORT}"
        exit 1
    fi
    echo "Waiting for server on port ${KIOSK_PORT}... (${elapsed}s)"
    sleep "${KIOSK_POLL_INTERVAL}"
done
echo "Server ready on port ${KIOSK_PORT}"

# Ensure Chromium data dirs exist and are owned by _chatos_ui.
# We set HOME to KIOSK_CHROMIUM_DATA_DIR so the actual profile lives
# at $HOME/.config/chromium.
mkdir -p "${KIOSK_CHROMIUM_DATA_DIR}/.config/chromium"
chown -R _chatos_ui "${KIOSK_CHROMIUM_DATA_DIR}"

# Clean stale Chromium SingletonLock (prevents "already running" errors)
rm -f "${KIOSK_CHROMIUM_DATA_DIR}/.config/chromium/SingletonLock"

# Set up runtime dir for Chromium
XDG_RUNTIME_DIR="/tmp/chatos-ui-runtime"
mkdir -p "${XDG_RUNTIME_DIR}"
chown _chatos_ui "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"
export XDG_RUNTIME_DIR

echo "Starting Chromium as _chatos_ui"

# Start Chromium as _chatos_ui — exec replaces this shell, so Chromium exit = X exit.
# HOME is set to KIOSK_CHROMIUM_DATA_DIR so Chrome uses its default profile at
# $HOME/.config/chromium. No --user-data-dir flag needed.
exec sudo -u _chatos_ui \
    env HOME="${KIOSK_CHROMIUM_DATA_DIR}" \
        DISPLAY="${DISPLAY}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    chromium-browser ${KIOSK_CHROMIUM_FLAGS} "${KIOSK_URL}"
